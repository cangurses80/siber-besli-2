// Generated by scripts/gen-rules.mjs from src/world.json. Do not edit by hand.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsPlayer(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validPlayerKeys(data) {
      return data.keys().hasAll([
        'nickname', 'createdAt', 'lastSeenAt', 'activeRegionId', 'currentIslandId',
        'solved', 'openBridges', 'openRegionBridges', 'schemaVersion'
      ]) && data.keys().hasOnly([
        'nickname', 'createdAt', 'lastSeenAt', 'activeRegionId', 'currentIslandId',
        'solved', 'openBridges', 'openRegionBridges', 'schemaVersion'
      ]);
    }

    function validNickname(nickname) {
      return nickname is string && nickname.size() >= 3 && nickname.size() <= 40;
    }

    function validRegionAndIsland(data) {
      return ['helios', 'khepri', 'uruk', 'quetzal', 'parsa', 'veda'].hasAny([data.activeRegionId])
        && (
        (data.activeRegionId == 'helios' && ['helios-01', 'helios-02', 'helios-03', 'helios-04', 'helios-05', 'helios-06', 'helios-07', 'helios-08'].hasAny([data.currentIslandId]))
        || (data.activeRegionId == 'khepri' && ['khepri-01', 'khepri-02', 'khepri-03', 'khepri-04', 'khepri-05', 'khepri-06', 'khepri-07', 'khepri-08', 'khepri-09', 'khepri-10'].hasAny([data.currentIslandId]))
        || (data.activeRegionId == 'uruk' && ['uruk-01', 'uruk-02', 'uruk-03', 'uruk-04', 'uruk-05', 'uruk-06', 'uruk-07', 'uruk-08', 'uruk-09', 'uruk-10'].hasAny([data.currentIslandId]))
        || (data.activeRegionId == 'quetzal' && ['quetzal-01', 'quetzal-02', 'quetzal-03', 'quetzal-04', 'quetzal-05', 'quetzal-06', 'quetzal-07', 'quetzal-08', 'quetzal-09', 'quetzal-10'].hasAny([data.currentIslandId]))
        || (data.activeRegionId == 'parsa' && ['parsa-01', 'parsa-02', 'parsa-03', 'parsa-04', 'parsa-05', 'parsa-06', 'parsa-07', 'parsa-08', 'parsa-09', 'parsa-10', 'parsa-11'].hasAny([data.currentIslandId]))
        || (data.activeRegionId == 'veda' && ['veda-01', 'veda-02', 'veda-03', 'veda-04', 'veda-05', 'veda-06', 'veda-07', 'veda-08', 'veda-09', 'veda-10', 'veda-11'].hasAny([data.currentIslandId]))
        );
    }

    function validSolvedRecord(record) {
      return record is map
        && record.keys().hasAll(['solvedAt', 'durationMs', 'attempts'])
        && record.keys().hasOnly(['solvedAt', 'durationMs', 'attempts'])
        && (record.solvedAt == null || record.solvedAt is timestamp)
        && record.durationMs is int
        && record.durationMs >= 0
        && record.attempts is int
        && record.attempts > 0;
    }

    function validSolvedShape(solved) {
      return solved is map
        && solved.size() <= 60
        && solved.keys().hasOnly([
        'helios-01', 'helios-02', 'helios-03', 'helios-04', 'helios-05',
        'helios-06', 'helios-07', 'helios-08', 'khepri-01', 'khepri-02',
        'khepri-03', 'khepri-04', 'khepri-05', 'khepri-06', 'khepri-07',
        'khepri-08', 'khepri-09', 'khepri-10', 'uruk-01', 'uruk-02',
        'uruk-03', 'uruk-04', 'uruk-05', 'uruk-06', 'uruk-07',
        'uruk-08', 'uruk-09', 'uruk-10', 'quetzal-01', 'quetzal-02',
        'quetzal-03', 'quetzal-04', 'quetzal-05', 'quetzal-06', 'quetzal-07',
        'quetzal-08', 'quetzal-09', 'quetzal-10', 'parsa-01', 'parsa-02',
        'parsa-03', 'parsa-04', 'parsa-05', 'parsa-06', 'parsa-07',
        'parsa-08', 'parsa-09', 'parsa-10', 'parsa-11', 'veda-01',
        'veda-02', 'veda-03', 'veda-04', 'veda-05', 'veda-06',
        'veda-07', 'veda-08', 'veda-09', 'veda-10', 'veda-11'
        ]);
    }

    // Firestore Rules has a 1,000-expression runtime limit. Every changed
    // puzzle record is validated as it enters the document; unchanged records
    // were validated by their own earlier write.
    function validSolvedUpdate(after, before, currentIslandId) {
      let changedKeys = after.diff(before).affectedKeys();
      return changedKeys.size() == 0
        || after.size() == 0
        || (
          changedKeys.hasOnly([currentIslandId])
          && after.keys().hasAny([currentIslandId])
          && validSolvedRecord(after[currentIslandId])
        );
    }

    function validOpenBridges(openBridges) {
      return openBridges is list
        && openBridges.size() <= 56
        && openBridges.size() == openBridges.toSet().size()
        && openBridges.hasOnly([
        'helios-bridge-01', 'helios-bridge-02', 'helios-bridge-03', 'helios-bridge-04', 'helios-bridge-05',
        'helios-bridge-06', 'helios-bridge-07', 'helios-bridge-08', 'helios-bridge-09', 'khepri-bridge-01',
        'khepri-bridge-02', 'khepri-bridge-03', 'khepri-bridge-04', 'khepri-bridge-05', 'khepri-bridge-06',
        'khepri-bridge-07', 'khepri-bridge-08', 'khepri-bridge-09', 'uruk-bridge-01', 'uruk-bridge-02',
        'uruk-bridge-03', 'uruk-bridge-04', 'uruk-bridge-05', 'uruk-bridge-06', 'uruk-bridge-07',
        'uruk-bridge-08', 'uruk-bridge-09', 'quetzal-bridge-01', 'quetzal-bridge-02', 'quetzal-bridge-03',
        'quetzal-bridge-04', 'quetzal-bridge-05', 'quetzal-bridge-06', 'quetzal-bridge-07', 'quetzal-bridge-08',
        'quetzal-bridge-09', 'parsa-bridge-01', 'parsa-bridge-02', 'parsa-bridge-03', 'parsa-bridge-04',
        'parsa-bridge-05', 'parsa-bridge-06', 'parsa-bridge-07', 'parsa-bridge-08', 'parsa-bridge-09',
        'parsa-bridge-10', 'veda-bridge-01', 'veda-bridge-02', 'veda-bridge-03', 'veda-bridge-04',
        'veda-bridge-05', 'veda-bridge-06', 'veda-bridge-07', 'veda-bridge-08', 'veda-bridge-09',
        'veda-bridge-10'
        ]);
    }

    function validOpenRegionBridges(openRegionBridges) {
      return openRegionBridges is list
        && openRegionBridges.size() <= 7
        && openRegionBridges.size() == openRegionBridges.toSet().size()
        && openRegionBridges.hasOnly([
        'region-bridge-01', 'region-bridge-02', 'region-bridge-03', 'region-bridge-04', 'region-bridge-05',
        'region-bridge-06', 'region-bridge-07'
        ]);
    }

    function validPlayer(data) {
      return validPlayerKeys(data)
        && data.schemaVersion == 1
        && validNickname(data.nickname)
        && data.createdAt is timestamp
        && data.lastSeenAt is timestamp
        && validRegionAndIsland(data)
        && validSolvedShape(data.solved)
        && validOpenBridges(data.openBridges)
        && validOpenRegionBridges(data.openRegionBridges);
    }

    match /players/{uid} {
      allow read: if ownsPlayer(uid);
      allow create: if ownsPlayer(uid)
        && validPlayer(request.resource.data)
        && request.resource.data.solved.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time;
      allow update: if ownsPlayer(uid)
        && validPlayer(request.resource.data)
        && validSolvedUpdate(
          request.resource.data.solved,
          resource.data.solved,
          request.resource.data.currentIslandId
        )
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
